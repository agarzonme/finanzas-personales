# Copia este archivo como .env y llena los valores. El .env real nunca se sube a GitHub.

# Base de datos. En local no hace falta: por defecto usa file:./data/finanzas.db
# En la nube (Turso): libsql://tu-base.turso.io
DATABASE_URL=
DATABASE_AUTH_TOKEN=

# Contraseña de la app. Genera las dos líneas con:
#   npm run hash-password -- "una-clave-larga"
APP_PASSWORD_HASH=
SESSION_SECRET=

# Pon true para exigir contraseña también en local (en Vercel siempre se exige)
REQUIRE_PASSWORD=false

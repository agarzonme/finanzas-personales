{
  "name": "mis-finanzas",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "db:setup": "tsx scripts/setup-db.ts",
    "predev": "tsx scripts/setup-db.ts",
    "dev": "next dev",
    "dev:lan": "next dev -H 0.0.0.0",
    "build": "tsx scripts/setup-db.ts && next build",
    "start": "next start",
    "start:lan": "next start -H 0.0.0.0",
    "db:generate": "drizzle-kit generate",
    "hash-password": "tsx scripts/hash-password.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "drizzle-orm": "^0.45.4",
    "jose": "^6.2.12",
    "next": "^16.4.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  }
}
